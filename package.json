{
  "name": "comclean",
  "version": "1.0.0",
  "description": "C??????? - ComClean",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --config.extraMetadata.main=main.js",
    "pack:dir": "electron-builder --win dir --config.extraMetadata.main=main.js"
  },
  "build": {
    "appId": "com.cleaner.comclean",
    "productName": "ComClean",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  }
}
